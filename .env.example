# WRAITH environment template — copy to .env and fill in what you use.
# Values here override config.yaml. Never commit your real .env.

# --- Dashboard ---
# Bearer token for the dashboard API. REQUIRED for Docker / any non-loopback bind.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_API_KEY=
DASHBOARD_ALLOWED_ORIGINS=http://localhost:5050
DASHBOARD_SECRET_KEY=

# --- Database (blank = SQLite) ---
# DATABASE_URL=postgresql+psycopg2://wraith:password@localhost/wraith
DATABASE_URL=

# --- Intelligence feeds ---
HIBP_API_KEY=
DEHASHED_EMAIL=
DEHASHED_API_KEY=
INTELX_API_KEY=
GITHUB_TOKEN=

# --- Alerting ---
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=
ALERT_TO_EMAIL=
